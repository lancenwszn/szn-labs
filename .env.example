# --- Public (exposed to the browser) ---------------------------------------
# Public URL of the deployed site, no trailing slash, e.g. https://your-domain
# Used for canonical URLs, sitemap, robots.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=
# Official contact address, shown in the Contact section and legal pages
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Server only (contact form delivery via resend.com) --------------------
# API key from the Resend dashboard
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=
# Sender, on a domain verified in Resend, e.g. SZN Labs Website <website@your-domain>
CONTACT_FROM_EMAIL=
