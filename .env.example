# Copy to .env.local for local development. In production, set these in the
# Vercel project settings (Settings -> Environment Variables), not in a file.

# --- Public (inlined into the browser bundle at build time) -----------------
# Final public URL of the site, e.g. https://your-domain (no trailing slash).
# Used for canonical URLs, sitemap, robots.txt, Open Graph and social tags.
# If unset on Vercel, the project's production domain is used instead.
NEXT_PUBLIC_SITE_URL=
# Official contact address shown in the Contact section and legal pages.
# Optional: while empty the site shows "Contact address coming soon".
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Server only (contact form delivery via resend.com) ---------------------
# All three are required for the contact form to deliver. Never prefix these
# with NEXT_PUBLIC_.
# API key from the Resend dashboard (starts with re_)
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. SZN Labs Website <website@your-domain>
CONTACT_FROM_EMAIL=
